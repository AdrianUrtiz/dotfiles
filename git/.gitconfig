[credential]
	helper = libsecret
[core]
	editor = code --wait
	autocrlf = input
[init]
	defaultBranch = main
[alias]
	st = status
	co = checkout
	cob = checkout -b
	br = branch
	ci = commit
	cm = commit -m
	df = diff
	lg = log --oneline --graph --decorate
	pl = pull
	ps = push
	f = fetch
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[include]
	path = ~/.gitconfig.identity
