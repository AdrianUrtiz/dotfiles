{
  "git.autofetch": true,
  "git.confirmSync": false,
  "workbench.activityBar.location": "bottom",
  "workbench.productIconTheme": "viraOutline",
  "editor.fontFamily": "'Cascadia Code PL'",
  "editor.fontSize": 14.3,
  "editor.fontLigatures": true,
  "workbench.startupEditor": "none",
  "files.autoSave": "afterDelay",
  "editor.minimap.enabled": false,
  "editor.formatOnSave": true,
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe",
      ],
      "args": [],
      "icon": "terminal-cmd",
    },
    "Git Bash": {
      "path": "C:\\Program Files\\Git\\bin\\bash.exe",
      "args": ["--login", "-i"],
    },
  },
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.cursorBlinking": "expand",
  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": false,
  "editor.guides.highlightActiveIndentation": true,
  "workbench.tree.renderIndentGuides": "onHover",
  "workbench.colorCustomizations": {
    "tree.indentGuidesStroke": "#333333",
    "tree.inactiveIndentGuidesStroke": "#00000000",
    "[Vira*]": {
      "statusBar.debuggingBackground": "#E9A58133",
      "statusBar.debuggingForeground": "#E9A581",
      "toolbar.activeBackground": "#E9A58126",
      "button.background": "#E9A581",
      "button.hoverBackground": "#E9A581cc",
      "extensionButton.separator": "#E9A58133",
      "extensionButton.background": "#E9A58114",
      "extensionButton.foreground": "#E9A581",
      "extensionButton.hoverBackground": "#E9A58133",
      "extensionButton.prominentForeground": "#E9A581",
      "extensionButton.prominentBackground": "#E9A58114",
      "extensionButton.prominentHoverBackground": "#E9A58133",
      "activityBarBadge.background": "#E9A581",
      "activityBar.activeBorder": "#E9A581",
      "activityBarTop.activeBorder": "#E9A581",
      "list.inactiveSelectionIconForeground": "#E9A581",
      "list.activeSelectionForeground": "#E9A581",
      "list.inactiveSelectionForeground": "#E9A581",
      "list.highlightForeground": "#E9A581",
      "sash.hoverBorder": "#E9A58180",
      "list.activeSelectionIconForeground": "#E9A581",
      "scrollbarSlider.activeBackground": "#E9A58180",
      "editorSuggestWidget.highlightForeground": "#E9A581",
      "textLink.foreground": "#E9A581",
      "progressBar.background": "#E9A581",
      "pickerGroup.foreground": "#E9A581",
      "tab.activeBorder": "#E9A581",
      "tab.activeBorderTop": "#E9A58100",
      "tab.unfocusedActiveBorder": "#E9A581",
      "tab.unfocusedActiveBorderTop": "#E9A58100",
      "tab.activeModifiedBorder": "#E9A58100",
      "notificationLink.foreground": "#E9A581",
      "editorWidget.resizeBorder": "#E9A581",
      "editorWidget.border": "#E9A581",
      "settings.modifiedItemIndicator": "#E9A581",
      "panelTitle.activeBorder": "#E9A581",
      "breadcrumb.activeSelectionForeground": "#E9A581",
      "menu.selectionForeground": "#E9A581",
      "menubar.selectionForeground": "#E9A581",
      "editor.findMatchBorder": "#E9A581",
      "selection.background": "#E9A58140",
      "statusBarItem.remoteBackground": "#E9A58114",
      "statusBarItem.remoteHoverBackground": "#E9A581",
      "statusBarItem.remoteForeground": "#E9A581",
      "notebook.inactiveFocusedCellBorder": "#E9A58180",
      "chat.slashCommandForeground": "#E9A581",
      "chat.avatarForeground": "#E9A581",
      "activityBarBadge.foreground": "#000000",
      "button.foreground": "#000000",
      "statusBarItem.remoteHoverForeground": "#000000",
      "titleBar.border": "#ffffff0f",
      "statusBar.border": "#ffffff0f",
      "sideBar.border": "#ffffff0f",
      "sideBarSectionHeader.border": "#ffffff0f",
      "panel.border": "#ffffff0f",
      "activityBar.border": "#ffffff0f",
      "sideBarActivityBarTop.border": "#ffffff0f",
      "sideBarStickyScroll.border": "#ffffff14",
      "extensionButton.border": "#E9A58114",
      "agentsPanel.border": "#ffffff0f",
      "surface.border": "#ffffff0f",
      "widget.border": "#ffffff0f",
    },
  },
  "explorer.confirmDelete": false,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "breadcrumbs.enabled": false,
  "git.ignoreRebaseWarning": true,
  "workbench.iconTheme": "vira-icons-ocean",
  "chat.viewSessions.orientation": "stacked",
  "workbench.colorTheme": "Vira Ocean High Contrast",
  "viraTheme.accent": "Vira",
  "viraTheme.hidesExplorerArrows": false,
  "viraTheme.useOutlinedIcons": true,
  "symbols.hidesExplorerArrows": false,
  "viraTheme.showBorders": true,
  "explorer.confirmDragAndDrop": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "agq.pinnedModels": [],
  "editor.inlineSuggest.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",
  "editor.scrollbar.vertical": "auto",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.matchBrackets": "never",
  "editor.stickyScroll.enabled": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.wordWrap": "wordWrapColumn",
  "editor.formatOnPaste": true,
  "git.openRepositoryInParentFolders": "always",
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, next.config.mjs, postcss.config.js, tailwind.config.js, jsconfig.json, .eslintrc.json, postcss.config.mjs, .gitignore, README.md, tsconfig.json, tsconfig.cjs.json, tsconfig.esm.json, tsconfig.json, .prettierrc, vite.config.js, postcss.config.cjs, .env, .env.local, Dockerfile, docker-compose.yml, Dockerfile.dev, docker-compose.dev.yml, vite.config.ts, components.json, eslint.config.js, .gitattributes, .gitlab-ci.yml, next.config.ts, .prettierignore, AGENTS.md, eslint.config.mjs, next-env.d.ts, .env.example, composer.json, composer.lock, artisan, artisan.bat, artisan.cmd, artisan.ps1, .htaccess, server.php, LICENSE, phpunit.xml, webpack.mix.js, .env.development, CLAUDE.md, prisma.*, next.*, proxy.ts, vercel.*, .node_modules, tsconfig.*",
  },
  "explorer.fileNesting.enabled": true,
  "window.titleBarStyle": "custom",
  "editor.linkedEditing": true,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "window.customTitleBarVisibility": "auto",
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.fontLigatures.enabled": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "explorer.confirmPasteNative": false,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "keyword",
          "storage",
          "variable.parameter",
          "variable.language",
          "entity.other.attribute-name",
          "markup.italic",
          "meta.jsx.attribute",
          "meta.tsx.attribute",
          "entity.name.tag",
          "entity.name.tag.js",
          "entity.name.tag.jsx",
          "entity.name.tag.ts",
          "entity.name.tag.tsx",
          "meta.tag.sgml.html",
          "meta.tag.sgml.html.jsx",
          "meta.tag.sgml.html.tsx",
        ],
        "settings": {
          "fontStyle": "italic",
        },
      },
    ],
  },
  "viraTheme.syncProductIcons": false,
}
